# --- Shopify app credentials (from your app's page in dev.shopify.com) ---
SHOPIFY_API_KEY=your_client_id_here
SHOPIFY_API_SECRET=your_client_secret_here
SHOPIFY_SCOPES=read_orders,read_fulfillments,read_customers
# The public URL your app is deployed at (e.g. https://your-app.up.railway.app)
APP_URL=https://your-app-url.com

# --- Email sending (SendGrid — free tier covers 100 emails/day) ---
SENDGRID_API_KEY=your_sendgrid_key_here
FROM_EMAIL=updates@yourdomain.com

# --- Server ---
PORT=3000

# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_random_string

# Used to encrypt each shop's Shopify access token before it's stored —
# without this set, the app will crash on first install rather than save
# a token in plain text. MUST be exactly 32 bytes as a 64-character hex
# string. Generate with: openssl rand -hex 32
# (If you don't have a terminal handy, any online "random hex string
# generator" set to 64 characters / 32 bytes works too — just don't reuse
# the example below, generate your own.)
ENCRYPTION_KEY=change_this_to_a_real_64_character_hex_string_before_deploying

# --- Alert engine tuning ---
# Days a line item can sit unfulfilled before an aging alert fires.
AGING_DAYS_THRESHOLD=5
# How many of a supplier's fulfilled orders are needed before their
# baseline is trusted enough to alert on deviation from it.
MIN_SAMPLE_FOR_BASELINE=5
# How many of a supplier's MOST RECENT fulfilled orders count as "current
# behavior" for pattern-shift comparison (kept separate from the baseline
# itself, so recent orders can't dilute their own comparison).
RECENT_WINDOW_SIZE=3
# How many times slower than a supplier's own baseline counts as a real
# shift worth alerting on (2 = twice as slow as normal).
PATTERN_SHIFT_MULTIPLIER=2
